#!/usr/bin/env python3
# markstay adoption hook  (do not edit this line: install.sh / --uninstall match on it)
#
# Pre-commit gate for markstay markers, mitigation #2 from the marker-survival
# eval turned into something a repo installs. For every staged Markdown file it:
#
#   - lints the staged version for well-formedness (malformed / orphan / duplicate
#     id, hash drift), and
#   - runs a regeneration diff of baseline -> staged, catching the AI-rewrite
#     failure mode: a stay dropped, duplicated, or relocated by the edit being
#     committed.
#
# The baseline is the same document before the edit, which is NOT the same thing as
# the same path before the edit. A stay's whole point is that identity is not
# positional, so the hook resolves the baseline by stay id, not by filename:
#
#   M  ->  HEAD:<path>
#   R  ->  HEAD:<old path>              (git recorded a rename)
#   A  ->  the document deleted in this same commit that shares the most stay ids
#
# That last case is the one path-keyed pairing misses. git's rename detection is
# content-similarity based, and similarity is anti-correlated with this failure
# mode: the more a rewrite destroys, the more stays it can drop AND the less git
# sees a rename. A measured real case scored 2% similarity, so it landed as
# delete + create and every drop went unreported. A surviving stay id is the
# stronger signal, so pairing keys on that.
#
# An id that moved to a different document in the same commit is reported as a
# move, not a loss: the stay is still in the commit, so blocking a deliberate
# reorganisation would be wrong. Only ids that leave the commit entirely block.
#
# Any error-level finding blocks the commit (SPEC.md §16: "exit non-zero so it can
# gate a commit hook"). Hash drift is a warning and does not block. The linter is
# the vendored copy at <repo>/.markstay/markstay_lint.py (installed by install.sh),
# so the hook stays dependency-free; set MARKSTAY_MODE=commonmark to segment over
# the CommonMark tree (SPEC.md §5.2, needs markdown-it-py). Set
# MARKSTAY_CHECK_COLLECTIONS=1 to also block when a stamped table or list silently
# loses a row/bullet (COLLECTION_SHRANK; off by default).
#
# Hash drift (a marker's hash no longer matching its in-place-edited block) is a
# non-blocking warning and is hidden from the hook output by default: a commit
# whose only findings are in-place edits prints nothing (it does not block, so
# there is nothing to act on). Set MARKSTAY_SHOW_DRIFT=1 to list drift findings.
# Bypass the whole check once with `git commit --no-verify`.

import os
import subprocess
import sys

MD_SUFFIXES = (".md", ".markdown")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def is_md(path):
    # `.markstay/` holds this hook's own vendored files, not the repo's content.
    # PRESERVE.md in particular demonstrates the marker form twice, so linting it
    # reports DUPLICATE_ID and would block an adopter's first `git add -A` right
    # after install.
    if path == ".markstay" or path.startswith(".markstay/"):
        return False
    return path.endswith(MD_SUFFIXES)


def staged_entries():
    """Staged changes as [(status, src, dst)].

    `--name-status -z` emits NUL-separated fields; a rename or copy carries two
    paths, everything else one. `--find-renames` is explicit so the listing does
    not change shape under a repo that sets `diff.renames=false`.
    """
    raw = git("diff", "--cached", "--name-status", "-z", "--find-renames").stdout
    fields = raw.split("\0")
    out, i = [], 0
    while i < len(fields) and fields[i]:
        status = fields[i][0]
        if status in ("R", "C") and i + 2 < len(fields):
            out.append((status, fields[i + 1], fields[i + 2]))
            i += 3
        elif i + 1 < len(fields):
            out.append((status, fields[i + 1], fields[i + 1]))
            i += 2
        else:
            break
    return out


def head_text(path):
    res = git("show", f"HEAD:{path}")
    return res.stdout if res.returncode == 0 else None


def main() -> int:
    root = git("rev-parse", "--show-toplevel").stdout.strip()
    if not root:
        return 0  # not in a work tree; nothing to do

    sys.path.insert(0, os.path.join(root, ".markstay"))
    try:
        import markstay_lint as L
    except ImportError:
        sys.stderr.write(
            "markstay hook: linter not found at .markstay/markstay_lint.py. "
            "Re-run the markstay install.sh to vendor it, or remove the hook. "
            "Skipping the markstay check for this commit.\n")
        return 0

    mode = os.environ.get("MARKSTAY_MODE", "blank-line")
    # Opt-in: also block when a kept stay's table/list lost rows/bullets
    # (COLLECTION_SHRANK). Off by default so existing repos are unaffected; the
    # kwarg is only passed when enabled, so an older vendored linter still works.
    check_collections = os.environ.get("MARKSTAY_CHECK_COLLECTIONS", "").lower() in (
        "1", "true", "yes", "on")
    # Hash drift is non-blocking and non-actionable in this channel, so it is
    # hidden by default; MARKSTAY_SHOW_DRIFT=1 lists it.
    show_drift = os.environ.get("MARKSTAY_SHOW_DRIFT", "").lower() in (
        "1", "true", "yes", "on")
    diff_kwargs = {"mode": mode}
    if check_collections:
        diff_kwargs["check_collections"] = True

    def ids_of(text):
        """The well-formed stay ids in a document."""
        # Degrade to no pairing rather than crashing on a vendored linter old
        # enough to predate the helper (the hook can outrun .markstay/).
        index = getattr(L, "_id_index", None)
        if index is None or text is None:
            return set()
        try:
            return set(index(L.parse_document(text, mode=mode)))
        except Exception:
            return set()

    entries = staged_entries()
    changed = [(st, src, dst) for st, src, dst in entries
               if st != "D" and is_md(dst)]
    deleted = [src for st, src, _ in entries if st == "D" and is_md(src)]
    if not changed and not deleted:
        return 0

    staged_text = {dst: git("show", f":{dst}").stdout for _, _, dst in changed}
    staged_ids = {p: ids_of(t) for p, t in staged_text.items()}
    # Union over the whole commit: an id present anywhere in the staged tree has
    # not been lost, wherever it ended up.
    committed_ids = set()
    for s in staged_ids.values():
        committed_ids |= s

    # Baseline id sets for the documents this commit deletes, so an added file can
    # be paired with the document it was renamed from.
    deleted_ids = {p: ids_of(head_text(p)) for p in deleted}
    claimed = set()

    def baseline_for(status, src, dst):
        """(text, origin_path) for the document this staged file came from."""
        if status == "R":
            text = head_text(src)
            if text is not None:
                return text, src
        elif status != "C":
            text = head_text(dst)
            if text is not None:
                return text, dst
        # No blob at this path in HEAD (added, or a rename git scored as
        # delete + create). Pair on shared stay ids instead of on the filename.
        mine = staged_ids.get(dst, set())
        best, best_n = None, 0
        for cand, cand_ids in deleted_ids.items():
            if cand in claimed:
                continue
            n = len(mine & cand_ids)
            if n > best_n:
                best, best_n = cand, n
        if best is not None:
            claimed.add(best)
            return head_text(best), best
        return None, None

    reports = []
    notes = []
    any_error = False
    for status, src, dst in changed:
        staged = staged_text[dst]
        baseline, origin = baseline_for(status, src, dst)
        try:
            _, findings = L.lint_document(staged, mode=mode)
            findings = list(findings)
            if baseline is not None:
                findings += L.lint_diff(baseline, staged, **diff_kwargs)
        except ImportError:
            sys.stderr.write(
                "markstay hook: MARKSTAY_MODE=commonmark needs markdown-it-py "
                "(pip install markdown-it-py), or unset MARKSTAY_MODE for the "
                "dependency-free default.\n")
            return 1

        # A stay that moved to another document in this commit is not lost. Report
        # the move and drop the finding, so reorganising documents does not block.
        kept = []
        for fd in findings:
            if fd.code == "DROPPED_ID" and fd.id in committed_ids:
                elsewhere = sorted(p for p, s in staged_ids.items()
                                   if p != dst and fd.id in s)
                notes.append(
                    f"  {fd.id}: moved out of {origin or dst} into "
                    f"{', '.join(elsewhere)} (still in this commit, not blocking)")
                continue
            kept.append(fd)
        findings = kept

        if findings:
            # Skip a file whose only findings are hidden drift, so a commit that
            # merely edited stamped blocks in place prints nothing (it does not
            # block, matching the fact drift is non-actionable here).
            if show_drift or any(fd.code != "HASH_DRIFT" for fd in findings):
                label = dst if origin in (None, dst) else f"{dst} (baseline {origin})"
                reports.append(L.render_text(label, findings, show_drift=show_drift))
            if L.has_errors(findings):
                any_error = True

    # A deleted document nothing was paired with: its stays left the repo. That is
    # usually deliberate, so it is a note rather than a blocking finding, but it is
    # said out loud instead of passing in silence.
    for path in deleted:
        if path in claimed:
            continue
        gone = deleted_ids.get(path, set()) - committed_ids
        if gone:
            notes.append(
                f"  {path}: deleted with {len(gone)} stay(s) that no staged file "
                f"carries ({', '.join(sorted(gone)[:6])}"
                f"{', ...' if len(gone) > 6 else ''})")

    if reports:
        sys.stderr.write("\n".join(reports) + "\n")
    if notes:
        sys.stderr.write("markstay: stays that changed document (not blocking):\n"
                         + "\n".join(notes) + "\n")
    if any_error:
        sys.stderr.write(
            "\nmarkstay: commit blocked, the edit above breaks a stay "
            "(dropped / duplicated / relocated / malformed). Fix it, or bypass "
            "once with `git commit --no-verify`.\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
